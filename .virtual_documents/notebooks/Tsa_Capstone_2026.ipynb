    prophet_test = prophet_full[
        (prophet_full['ds'] >= test_start) &
        (prophet_full['ds'] <= test_end)
    ]
    
    fig.add_trace(go.Scatter(
        x=prophet_test['ds'],
        y=prophet_test['yhat'],
        name='Prophet Forecast',
        line=dict(color='green', dash='dot', width=1.5)
    ))
    
    # ── LSTM ── (numpy array)
