correct_d2 = 0

print(f"\n{'Stock':<12} {'Buy Price':>10} {'Pred D1':>10} {'Act D1':>10} {'Err D1%':>8} {'Pred D2':>10} {'Act D2':>10} {'Err D2%':>8}")
print("-" * 90)

for name in shares_bought.keys():
    buy_price  = actual_buy_prices[name]
    act_d1     = actual_close_day1[name]
    act_d2     = actual_close_day2[name]
    pred_d1    = signals[name]['ens_day1']
    pred_d2    = signals[name]['ens_day2']
    
    # Errors
    err_d1 = abs(act_d1 - pred_d1) / act_d1 * 100
    err_d2 = abs(act_d2 - pred_d2) / act_d2 * 100
    total_mape_d1 += err_d1
    total_mape_d2 += err_d2
    
    # Directional accuracy Day 1
    act_dir_d1  = "UP" if act_d1 > buy_price else "DOWN"
    pred_dir_d1 = "UP" if pred_d1 > buy_price else "DOWN"
    if act_dir_d1 == pred_dir_d1:
        correct_d1 += 1
    
    # Directional accuracy Day 2
    act_dir_d2  = "UP" if act_d2 > act_d1 else "DOWN"
    pred_dir_d2 = "UP" if pred_d2 > pred_d1 else "DOWN"
    if act_dir_d2 == pred_dir_d2:
        correct_d2 += 1
    
    task8_rows.append({
        'Stock':           name,
        'Buy Price':       buy_price,
        'Predicted Day1':  pred_d1,
        'Actual Day1':     act_d1,
        'Error D1 (%)':    round(err_d1, 2),
        'Dir D1 Correct':  act_dir_d1 == pred_dir_d1,
        'Predicted Day2':  pred_d2,
        'Actual Day2':     act_d2,
        'Error D2 (%)':    round(err_d2, 2),
        'Dir D2 Correct':  act_dir_d2 == pred_dir_d2,
    })
    
    print(f"{name:<12} ₹{buy_price:>8.2f}  ₹{pred_d1:>8.2f}  ₹{act_d1:>8.2f}  "
          f"{err_d1:>6.2f}%  ₹{pred_d2:>8.2f}  ₹{act_d2:>8.2f}  {err_d2:>6.2f}%")

n = len(shares_bought)
print("\n" + "=" * 90)
print(f"MAPE Day 1:              {total_mape_d1/n:.2f}%")
print(f"MAPE Day 2:              {total_mape_d2/n:.2f}%")
print(f"Directional Acc Day 1:   {correct_d1}/{n} ({correct_d1/n*100:.1f}%)")
print(f"Directional Acc Day 2:   {correct_d2}/{n} ({correct_d2/n*100:.1f}%)")

# Save
task8_df = pd.DataFrame(task8_rows)
task8_df.to_csv('../outputs/task8_complete_analysis.csv', index=False)
print("\n✅ Saved to outputs/task8_complete_analysis.csv")


# ============================================================
# FINAL PORTFOLIO P&L SUMMARY
# ============================================================

TOTAL_CAPITAL = 1_000_000

print("=" * 80)
print("FINAL PORTFOLIO P&L — 2 DAY WINDOW")
print("=" * 80)
print(f"{'Stock':<12} {'Shares':>7} {'Buy':>10} {'Day1':>10} {'Day2':>10} "
      f"{'D1 P&L':>10} {'D2 P&L':>10} {'Total P&L':>10}")
print("=" * 80)

total_pnl_d1   = 0
total_pnl_d2   = 0
portfolio_rows = []

for name in shares_bought.keys():
    shares     = shares_bought[name]
    buy_price  = actual_buy_prices[name]
    close_d1   = actual_close_day1[name]
    close_d2   = actual_close_day2[name]
    
    pnl_d1     = (close_d1 - buy_price) * shares
    pnl_d2     = (close_d2 - buy_price) * shares
    ret_d1     = (close_d1 - buy_price) / buy_price * 100
    ret_d2     = (close_d2 - buy_price) / buy_price * 100
    
    total_pnl_d1 += pnl_d1
    total_pnl_d2 += pnl_d2
    
    emoji = "🟢" if pnl_d2 >= 0 else "🔴"
    print(f"{name:<12} {shares:>7}  ₹{buy_price:>8.2f}  ₹{close_d1:>8.2f}  "
          f"₹{close_d2:>8.2f}  ₹{pnl_d1:>8.2f}  ₹{pnl_d2:>8.2f}  {emoji}₹{pnl_d2:>8.2f}")
    
    portfolio_rows.append({
        'Stock':          name,
        'Shares':         shares,
        'Buy Price':      buy_price,
        'Day1 Close':     close_d1,
        'Day2 Close':     close_d2,
        'Day1 P&L (₹)':  round(pnl_d1, 2),
        'Day2 P&L (₹)':  round(pnl_d2, 2),
        'Day1 Return %':  round(ret_d1, 2),
        'Day2 Return %':  round(ret_d2, 2),
    })

print("=" * 80)
print(f"\n{'Day 1 Total P&L:':<30} ₹{total_pnl_d1:>10,.2f}  "
      f"({total_pnl_d1/TOTAL_CAPITAL*100:>+.3f}%)")
print(f"{'Day 2 Total P&L:':<30} ₹{total_pnl_d2:>10,.2f}  "
      f"({total_pnl_d2/TOTAL_CAPITAL*100:>+.3f}%)")
print(f"\n{'Invested Value:':<30} ₹{976_988.88:>10,.2f}")
print(f"{'Final Portfolio Value:':<30} ₹{976_988.88 + total_pnl_d2:>10,.2f}")
print(f"{'Overall Return:':<30} {total_pnl_d2/TOTAL_CAPITAL*100:>+.3f}%")

# Winners and losers
print("\n--- WINNERS ---")
for row in portfolio_rows:
    if row['Day2 P&L (₹)'] > 0:
        print(f"  🟢 {row['Stock']:<12} +₹{row['Day2 P&L (₹)']:>8,.2f}  ({row['Day2 Return %']:>+.2f}%)")

print("\n--- LOSERS ---")
for row in portfolio_rows:
    if row['Day2 P&L (₹)'] < 0:
        print(f"  🔴 {row['Stock']:<12}  ₹{row['Day2 P&L (₹)']:>8,.2f}  ({row['Day2 Return %']:>+.2f}%)")

# Save
portfolio_df = pd.DataFrame(portfolio_rows)
portfolio_df.to_csv('../outputs/final_portfolio_pnl.csv', index=False)
print("\n✅ Saved to outputs/final_portfolio_pnl.csv")


